# =============================================================================
# AGGRESSIVE TRADING CONFIGURATION (Fee-Aware - Jan 2025)
# =============================================================================
# WARNING: This configuration is HIGH RISK. You can lose your entire bankroll.
# Based on analysis of high-volume Polymarket traders like @0x8dxd
#
# IMPORTANT: Polymarket now has dynamic taker fees up to 3.15% near 50% odds.
# This config prioritizes MAKER orders (POST_ONLY) to EARN rebates instead.
# Strategy: High volume maker trading with compounding position sizing.

# =============================================================================
# WALLET CONFIGURATION (Required)
# =============================================================================
PK=0x_your_private_key_here
FUNDER=0x_your_deposit_address_here

# =============================================================================
# TRADING MODE
# =============================================================================
TRADING_MODE=aggressive

# =============================================================================
# AGGRESSIVE TRADING PARAMETERS
# =============================================================================
# Lower edge threshold = more trades (maker orders minimize fee impact)
MIN_EDGE=0.08

# Trade closer to expiry for more opportunities
MIN_TIME_REMAINING=30

# Base position size (will compound based on bankroll)
BASE_POSITION_SIZE=20

# Use up to 35% of bankroll per position (compounding)
MAX_POSITION_PCT=0.35

# Allow more concurrent positions
MAX_CONCURRENT_POSITIONS=8

# Higher daily loss tolerance
DAILY_LOSS_LIMIT=0.40

# =============================================================================
# FEE-AWARE EDGE THRESHOLDS (Prioritize Maker Orders)
# =============================================================================
# POST_ONLY is preferred - earns rebates instead of paying fees
EDGE_FOR_POST_ONLY=0.08
EDGE_FOR_LIMIT=0.20
# Only use MARKET when VERY urgent (fees are brutal)
EDGE_FOR_MARKET=0.40

# Tighter time thresholds - use LIMIT/MARKET only when necessary
TIME_FOR_MARKET=25
TIME_FOR_LIMIT=45

# Shorter maker timeout - cycle orders faster
MAKER_ORDER_TIMEOUT=10

# =============================================================================
# WEBSOCKET SETTINGS (keep defaults)
# =============================================================================
WS_MAX_RETRIES=10
WS_RECONNECT_DELAY=1.0
WS_MAX_RECONNECT_DELAY=60.0
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# =============================================================================
# BOT MODE
# =============================================================================
# Start with DRY_RUN=true to test first!
DRY_RUN=true

# =============================================================================
# NOTIFICATIONS (Optional but recommended for monitoring)
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
