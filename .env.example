# ============================================================================
# Polymarket Crypto Arbitrage Bot — Configuration
# ============================================================================
# Copy this file to .env and edit with your settings.
# Lines starting with # are comments. Uncomment to override defaults.
#
# THREE TRADING PROFILES are included below (Conservative / Normal / Aggressive).
# Uncomment the one that fits your risk appetite.
# ============================================================================

# ── WALLET CONFIG (required for live trading) ───────────────────────────────
PK=0x_your_private_key_here
FUNDER=

# Optional — auto-derived from PK if omitted
# CLOB_API_KEY=
# CLOB_SECRET=
# CLOB_PASS_PHRASE=

# ── RUNTIME MODE ────────────────────────────────────────────────────────────
DRY_RUN=true
PAPER_TRADING_ENABLED=false
# LOOP_INTERVAL=0.25

# ── STRATEGY ────────────────────────────────────────────────────────────────
SIMPLE_MODE=true
AGGRESSIVE_MODE=false
# CHART_FILTER_ENABLED=true

# ── MARKET VARIANTS ─────────────────────────────────────────────────────────
# Which market durations to trade: "fifteen", "five", or "fifteen,five"
TRADING_VARIANTS=fifteen
# ASSET_PRIORITY=BTC,ETH,SOL,XRP

# 5-minute market timing (only used when TRADING_VARIANTS includes "five")
# MIN_TIME_REMAINING_5M=15
# MIN_OBSERVATION_TIME_5M=10


# ============================================================================
#  TRADING PROFILES — Uncomment ONE section below
# ============================================================================

# ── CONSERVATIVE PROFILE ────────────────────────────────────────────────────
# Small positions, tight loss limits, slow recovery. Best for starting out.
# TRADING_MODE=conservative
# BASE_POSITION_SIZE=5
# MAX_POSITION_PCT=0.05
# MAX_CONCURRENT_POSITIONS=2
# MAX_TOTAL_EXPOSURE_USD=50
# MAX_EXPOSURE_PER_ASSET_USD=30
# MAX_TOTAL_EXPOSURE_PCT=0.15
# MIN_EDGE=0.01
# ORDER_COOLDOWN_SECONDS=30
# DAILY_LOSS_LIMIT=0.10
# MAX_CONSECUTIVE_LOSSES=2
# MAX_DRAWDOWN_PCT=0.10
# MIN_WIN_RATE=0.45
# COOLOFF_PERIOD_MINUTES=60
# PEAK_DECAY_RATE_PER_HOUR=0.03
# EDGE_FOR_POST_ONLY=0.04
# EDGE_FOR_LIMIT=0.10
# EDGE_FOR_MARKET=0.20

# ── NORMAL PROFILE (Default) ───────────────────────────────────────────────
# Balanced risk/reward. Trades all four assets.
TRADING_MODE=normal
BASE_POSITION_SIZE=25
MAX_POSITION_PCT=0.10
MAX_CONCURRENT_POSITIONS=4
MAX_TOTAL_EXPOSURE_USD=200
MAX_EXPOSURE_PER_ASSET_USD=75
MAX_TOTAL_EXPOSURE_PCT=0.25
MIN_EDGE=0.00
ORDER_COOLDOWN_SECONDS=10
DAILY_LOSS_LIMIT=0.25
MAX_CONSECUTIVE_LOSSES=3
MAX_DRAWDOWN_PCT=0.15
MIN_WIN_RATE=0.40
COOLOFF_PERIOD_MINUTES=30
PEAK_DECAY_RATE_PER_HOUR=0.05
EDGE_FOR_POST_ONLY=0.03
EDGE_FOR_LIMIT=0.08
EDGE_FOR_MARKET=0.15

# ── AGGRESSIVE PROFILE ─────────────────────────────────────────────────────
# Larger positions, looser limits, faster recovery. For experienced users.
# TRADING_MODE=aggressive
# BASE_POSITION_SIZE=50
# MAX_POSITION_PCT=0.15
# MAX_CONCURRENT_POSITIONS=6
# MAX_TOTAL_EXPOSURE_USD=500
# MAX_EXPOSURE_PER_ASSET_USD=150
# MAX_TOTAL_EXPOSURE_PCT=0.35
# MIN_EDGE=0.00
# ORDER_COOLDOWN_SECONDS=5
# DAILY_LOSS_LIMIT=0.35
# MAX_CONSECUTIVE_LOSSES=5
# MAX_DRAWDOWN_PCT=0.20
# MIN_WIN_RATE=0.35
# COOLOFF_PERIOD_MINUTES=15
# PEAK_DECAY_RATE_PER_HOUR=0.10
# EDGE_FOR_POST_ONLY=0.02
# EDGE_FOR_LIMIT=0.05
# EDGE_FOR_MARKET=0.10


# ============================================================================
#  ADDITIONAL SETTINGS (all have sensible defaults — uncomment to override)
# ============================================================================

# ── TIMING ──────────────────────────────────────────────────────────────────
MIN_TIME_REMAINING=30
# TIME_FOR_MARKET=60
# TIME_FOR_LIMIT=120
# MAKER_ORDER_TIMEOUT=30
# WARMUP_PERIOD=60
# MIN_OBSERVATION_TIME=30
# MIN_PRICE_SAMPLES=10

# ── POSITION SIZING ────────────────────────────────────────────────────────
# DYNAMIC_SIZING_ENABLED=true
# TARGET_VOLATILITY=0.006
# KELLY_CAP=0.20
# MAX_EXPOSURE_PCT=0.10
# MIN_TRADE_USD=5.0

# ── EARLY EXIT ──────────────────────────────────────────────────────────────
# EARLY_EXIT_ENABLED=false
# TAKE_PROFIT_PCT=0.30
# STOP_LOSS_PCT=0.25
# EARLY_EXIT_MIN_HOLD=60
# EARLY_EXIT_INTERVAL=5
# TIME_EXIT_ENABLED=true
# TIME_EXIT_SECONDS=90
# EXIT_EDGE_THRESHOLD=0.01

# ── TREND PROTECTION ───────────────────────────────────────────────────────
# TREND_PROTECTION_ENABLED=false
# MAX_OPPOSITE_TREND_1D=0.25
# MAX_OPPOSITE_TREND_1H=0.40
# VELOCITY_GUARD_ENABLED=true
# BINANCE_MOMENTUM_ENABLED=true
# BINANCE_VELOCITY_THRESHOLD=0.001
# BINANCE_MOMENTUM_BOOST=0.02
# DYNAMIC_EDGE_ENABLED=true
# CONSECUTIVE_ENABLED=true

# ── EXECUTION ───────────────────────────────────────────────────────────────
# SMART_ROUTER_ENABLED=true
# MAKER_EDGE_THRESHOLD=0.02
# TAKER_EDGE_THRESHOLD=0.06
# MAX_SPREAD=0.05
# STALE_ORDER_SECONDS=30
# PARALLEL_EXECUTION=true
# MAX_ORDERS_PER_MIN=10

# ── ARBITRAGE ───────────────────────────────────────────────────────────────
# ARB_DUMP_THRESHOLD=0.15
# ARB_HEDGE_THRESHOLD=0.95
# ARB_ENTRY_WINDOW=2.0
# ARB_MIN_SPREAD=0.025

# ── PAPER TRADING ───────────────────────────────────────────────────────────
PAPER_INITIAL_BALANCE=1000
# PAPER_MAKER_FEE_BPS=1.0
# PAPER_TAKER_FEE_BPS=2.5
# PAPER_SLIPPAGE_BPS=2.0
# BOT_STATE_FILE=bot_state.json

# ── WEBSOCKET RESILIENCE ───────────────────────────────────────────────────
# WS_MAX_RETRIES=10
# WS_RECONNECT_DELAY=1.0
# WS_MAX_RECONNECT_DELAY=60.0
# WS_PING_INTERVAL=30
# WS_PING_TIMEOUT=10

# ── MONITORING ──────────────────────────────────────────────────────────────
MONITORING_ENABLED=true
# MONITORING_OUTPUT_PATH=data/metrics.jsonl
# MONITORING_ROLLING_WINDOW=50
MONITOR_WS_PORT=8765

# ── MACHINE LEARNING ───────────────────────────────────────────────────────
# Legacy ML confidence filter
ML_ENABLED=false
# ML_MIN_CONFIDENCE=0.52
# ML_MIN_SAMPLES=50
# ML_MIN_EDGE=0.02

# EV-based ML engine (advanced)
# ML_ENGINE_ENABLED=false
# ML_BUNDLE_PATH=models/ml_bundle
# ML_FEES_BPS=2.5
# ML_SLIPPAGE_BPS=2.0
# ML_MIN_EV=0.01
# ML_MAX_UNCERTAINTY=0.10
# ML_MAX_SPREAD=0.06
# ML_MIN_DEPTH=50
# ML_MAX_EXPOSURE_PCT=0.10
# ML_EV_SIZING_SCALE=0.10
# ML_TARGET_VOLATILITY=0.006

# ── NOTIFICATIONS (optional) ───────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
