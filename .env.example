# Polymarket 15-Minute Crypto Arbitrage Bot Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# WALLET CONFIGURATION (Required)
# =============================================================================
# Private key for your wallet (with 0x prefix)
PK=0x_your_private_key_here

# Funder address - ONLY required for proxy wallets (Magic/browser wallets)
# If you're using a standard EOA wallet (e.g., MetaMask), leave this empty
# If you're using Polymarket's browser wallet, set this to your deposit address
FUNDER=

# Wallet Types:
# - EOA Wallet: Leave FUNDER empty. Uses signature_type=0
#   This is for standard Ethereum wallets like MetaMask
#
# - Proxy Wallet: Set FUNDER to your Polymarket deposit address. Uses signature_type=1
#   This is for Polymarket's browser/Magic wallet system
#   Find your deposit address at: https://polymarket.com/wallet

# =============================================================================
# API CREDENTIALS (Optional - will be derived from PK if not set)
# =============================================================================
# If you've already generated API credentials, you can set them here
# to avoid re-generating on each startup
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# =============================================================================
# TRADING MODE
# =============================================================================
# Options: "conservative", "normal", "aggressive"
# - conservative: Higher edge requirements, smaller positions
# - normal: Balanced risk/reward (default)
# - aggressive: Lower edge thresholds, larger positions, compounding
#
# WARNING: Aggressive mode is HIGH RISK. You can lose your entire bankroll.
TRADING_MODE=normal

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
# Minimum edge required to enter a trade (0.0 - 1.0)
# Typical arbitrage edge: 3-10%. Higher edge = fewer but safer trades.
# Default: 0.03 (3%)
MIN_EDGE=0.03

# Minimum time remaining before market close (seconds)
# Default: 30 (trades with at least 30 seconds left)
MIN_TIME_REMAINING=30

# Base position size in USD
# Default: 25
BASE_POSITION_SIZE=25

# Maximum position as percentage of bankroll (0.0 - 1.0)
# Default: 0.15 (15% per position)
MAX_POSITION_PCT=0.15

# Maximum concurrent open positions
# Default: 8
MAX_CONCURRENT_POSITIONS=8

# Daily loss limit as percentage of starting bankroll (0.0 - 1.0)
# Default: 0.25 (25% - stop trading after 25% loss)
DAILY_LOSS_LIMIT=0.25

# =============================================================================
# EDGE AND TIME THRESHOLDS
# =============================================================================
# IMPORTANT: Polymarket has dynamic taker fees up to 3.15% near 50% odds.
# POST_ONLY orders earn maker rebates instead of paying fees.
# Prioritize POST_ONLY orders when possible!

# Minimum edge for POST_ONLY orders (maker rebates, preferred)
# Default: 0.03 (3%) - matches MIN_EDGE
EDGE_FOR_POST_ONLY=0.03

# Minimum edge for LIMIT orders (may take liquidity)
# Default: 0.08 (8%) - use when edge is higher and time is limited
EDGE_FOR_LIMIT=0.08

# Minimum edge for MARKET orders (guaranteed fill, pays fees)
# Default: 0.15 (15%) - only use with high edge and urgency
EDGE_FOR_MARKET=0.15

# Time remaining threshold for MARKET orders (seconds)
# Default: 60
TIME_FOR_MARKET=60

# Time remaining threshold for LIMIT orders (seconds)
# Default: 120
TIME_FOR_LIMIT=120

# Maker order timeout before cancellation (seconds)
# Default: 30
MAKER_ORDER_TIMEOUT=30

# =============================================================================
# WEBSOCKET SETTINGS
# =============================================================================
# Maximum reconnection attempts before circuit breaker opens
WS_MAX_RETRIES=10

# Initial reconnect delay (seconds)
WS_RECONNECT_DELAY=1.0

# Maximum reconnect delay with exponential backoff (seconds)
WS_MAX_RECONNECT_DELAY=60.0

# WebSocket ping interval for keepalive (seconds)
WS_PING_INTERVAL=30

# WebSocket ping timeout (seconds)
WS_PING_TIMEOUT=10

# =============================================================================
# BOT MODE
# =============================================================================
# Set to 'true' to run without placing actual trades (simulation mode)
# RECOMMENDED: Start with DRY_RUN=true to test your configuration!
DRY_RUN=true

# =============================================================================
# NOTIFICATIONS (Optional)
# =============================================================================
# Telegram bot token and chat ID for trade notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord webhook URL for trade notifications
DISCORD_WEBHOOK_URL=

# =============================================================================
# CONSERVATIVE MODE REFERENCE
# =============================================================================
# For safer trading with higher edge requirements:
#
# MIN_EDGE=0.08
# EDGE_FOR_POST_ONLY=0.08
# EDGE_FOR_LIMIT=0.15
# EDGE_FOR_MARKET=0.25
# BASE_POSITION_SIZE=15
# MAX_POSITION_PCT=0.08
# MAX_CONCURRENT_POSITIONS=4

# =============================================================================
# AGGRESSIVE MODE QUICK REFERENCE
# =============================================================================
# WARNING: Higher risk, more trades. Only use if you understand the risks!
#
# MIN_EDGE=0.02
# EDGE_FOR_POST_ONLY=0.02
# EDGE_FOR_LIMIT=0.05
# EDGE_FOR_MARKET=0.10
# BASE_POSITION_SIZE=50
# MAX_POSITION_PCT=0.25
# MAX_CONCURRENT_POSITIONS=12
# DAILY_LOSS_LIMIT=0.35

# =============================================================================
# MACHINE LEARNING CONFIGURATION
# =============================================================================
# Enable ML-based trade filtering (set to true after collecting training data)
# The ML system uses 82 features including chart analysis and new indicators:
# - MACD, Bollinger Bands, Stochastic, RSI Divergence
# - Volume analysis, Heiken Ashi, VWAP
# - Multi-timeframe trends, pattern matching
ML_ENABLED=true

# Minimum ML confidence required to take a trade (0.5 - 1.0)
# Higher = more selective, fewer trades but potentially better quality
# Start with 0.52 for slight edge filtering
# Default: 0.52
ML_MIN_CONFIDENCE=0.52

# Minimum training samples before ML filtering kicks in
# Lower = faster learning but potentially less reliable predictions
# Default: 30 (faster learning mode)
ML_MIN_SAMPLES=30

# Use hybrid predictor (combines pre-trained RF + adaptive neural network)
# Default: true
ML_USE_HYBRID=true

# =============================================================================
# GRADIENT BOOSTING SETTINGS (Advanced)
# =============================================================================
# Number of boosting rounds (more = potentially better but slower)
# Default: 100
GBM_N_ESTIMATORS=100

# Learning rate for gradient boosting (lower = more stable)
# Default: 0.08
GBM_LEARNING_RATE=0.08

# L2 regularization strength (higher = less overfitting)
# Default: 0.1
GBM_L2_LAMBDA=0.1

# Enable early stopping (prevents overfitting)
# Default: true
GBM_EARLY_STOPPING=true

# =============================================================================
# SEQUENCE MEMORY SETTINGS (Pattern Matching)
# =============================================================================
# Enable LSTM-style sequence pattern matching
# Default: true
SEQUENCE_MEMORY_ENABLED=true

# Length of price sequences for pattern matching
# Default: 15
SEQUENCE_LENGTH=15

# Minimum similarity score to consider a pattern match (0.0 - 1.0)
# Default: 0.7
SEQUENCE_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# THE GRAPH API (Optional - for on-chain data)
# =============================================================================
# API key for The Graph protocol (free tier: 100k queries/month)
# Get one at: https://thegraph.com/studio/
# Used for live tracking of redemptions, splits, merges, and settlements
GRAPH_API_KEY=

# =============================================================================
# ML TUNING TIPS
# =============================================================================
# 1. Start with ML_ENABLED=false to collect training data
# 2. After 30+ trades, enable ML with ML_MIN_CONFIDENCE=0.52
# 3. Run backtest: python scripts/ml_analysis.py
# 4. If win rate improves, gradually increase ML_MIN_CONFIDENCE to 0.55
# 5. Monitor feature importance to see which indicators matter most
#
# Key features the ML learns from:
# - Edge quality and trade timing
# - Binance price lead confirmation
# - Multi-timeframe trend alignment
# - MACD crossovers and histogram
# - Bollinger Band position (breakouts vs mean reversion)
# - Stochastic overbought/oversold conditions
# - RSI divergence detection
# - Volume spikes and OBV trends
# - Heiken Ashi trend continuation signals
# - VWAP distance and position
