# Polymarket 15-Minute Crypto Bot (.env example)

### WALLET CONFIG ###
PK=0x_your_private_key_here
FUNDER=

### API CREDENTIALS (optional) ###
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

### RUNTIME MODE ###
DRY_RUN=true
PAPER_TRADING_ENABLED=false

### TRADING CONFIG ###
TRADING_MODE=normal
SIMPLE_MODE=true
AGGRESSIVE_MODE=false
MIN_EDGE=0.00
MIN_TIME_REMAINING=30
BASE_POSITION_SIZE=25
MAX_POSITION_PCT=0.10
MAX_CONCURRENT_POSITIONS=4
MAX_ORDERS_PER_MIN=10
MAX_TOTAL_EXPOSURE_USD=200
MAX_EXPOSURE_PER_ASSET_USD=75
ORDER_COOLDOWN_SECONDS=10
DAILY_LOSS_LIMIT=0.25
EDGE_FOR_POST_ONLY=0.03
EDGE_FOR_LIMIT=0.08
EDGE_FOR_MARKET=0.15
TIME_FOR_MARKET=60
TIME_FOR_LIMIT=120
MAKER_ORDER_TIMEOUT=30

### WEBSOCKET CONFIG ###
WS_MAX_RETRIES=10
WS_RECONNECT_DELAY=1.0
WS_MAX_RECONNECT_DELAY=60.0
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

### PAPER TRADING CONFIG ###
PAPER_INITIAL_BALANCE=1000
PAPER_MAKER_FEE_BPS=1.0
PAPER_TAKER_FEE_BPS=2.5
PAPER_SLIPPAGE_BPS=2.0

### MONITORING ###
MONITORING_ENABLED=true
MONITORING_OUTPUT_PATH=data/metrics.jsonl
MONITORING_ROLLING_WINDOW=50

### MACHINE LEARNING CONFIG ###
# ML_MODE selects which ML system you intend to use.
# EV uses the bundle-based engine; LEGACY uses the old confidence filter.
ML_ENABLED=false
ML_MODE=EV
ML_BUNDLE=models/bundle_v1
ML_MIN_EDGE=0.02
ML_MIN_CONFIDENCE=0.0

# EV engine (used when ML_ENGINE_ENABLED=true)
ML_ENGINE_ENABLED=false
ML_BUNDLE_PATH=models/ml_bundle
ML_FEES_BPS=2.5
ML_SLIPPAGE_BPS=2.0
ML_MIN_EV=0.01
ML_MAX_UNCERTAINTY=0.10
ML_MAX_SPREAD=0.06
ML_MIN_DEPTH=50
ML_MAX_EXPOSURE_PCT=0.10
ML_EV_SIZING_SCALE=0.10
ML_TARGET_VOLATILITY=0.006

# Legacy ML filter (used when ML_ENABLED=true)
ML_MIN_SAMPLES=50
