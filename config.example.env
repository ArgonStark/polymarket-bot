# Example configuration for live/paper/backtest

# Wallet (required for live trading)
PK=0x_your_private_key_here
FUNDER=

# Mode
DRY_RUN=false
PAPER_TRADING_ENABLED=true
PAPER_INITIAL_BALANCE=1000

# Strategy
SIMPLE_MODE=true
MULTI_STRATEGY_ENABLED=true
STRATEGY_WEIGHT_TREND=0.4
STRATEGY_WEIGHT_MEAN_REVERSION=0.3
STRATEGY_WEIGHT_MOMENTUM=0.3

# Prediction
PREDICTION_ENABLED=true
PREDICTION_MODEL_PATH=models/gbm_model.pkl
PREDICTION_MIN_CONFIDENCE=0.55

# Risk sizing
DYNAMIC_SIZING_ENABLED=true
TARGET_VOLATILITY=0.006
KELLY_CAP=0.20
MAX_EXPOSURE_PCT=0.10
MIN_TRADE_USD=5.0

# Execution
SMART_ROUTER_ENABLED=true
MAKER_EDGE_THRESHOLD=0.02
TAKER_EDGE_THRESHOLD=0.06
MAX_SPREAD=0.05

# Monitoring
MONITORING_ENABLED=true
MONITORING_OUTPUT_PATH=data/metrics.jsonl
MONITORING_ROLLING_WINDOW=50

# ML engine
ML_ENGINE_ENABLED=true
ML_BUNDLE_PATH=models/ml_bundle
ML_FEES_BPS=2.5
ML_SLIPPAGE_BPS=2.0
ML_MIN_EV=0.01
ML_MAX_UNCERTAINTY=0.10
ML_MAX_SPREAD=0.06
ML_MIN_DEPTH=50
ML_MAX_EXPOSURE_PCT=0.10
ML_EV_SIZING_SCALE=0.10
ML_TARGET_VOLATILITY=0.006
