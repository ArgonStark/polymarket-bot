# Example configuration for live/paper/backtest
# See .env.example for the full reference with all options.

# Wallet (required for live trading)
PK=0x_your_private_key_here
FUNDER=

# Mode
DRY_RUN=false
PAPER_TRADING_ENABLED=true
PAPER_INITIAL_BALANCE=1000

# Strategy
SIMPLE_MODE=true

# Market variants: "fifteen", "five", or "fifteen,five"
TRADING_VARIANTS=fifteen

# Trading (Normal profile)
TRADING_MODE=normal
BASE_POSITION_SIZE=25
MAX_POSITION_PCT=0.10
MAX_CONCURRENT_POSITIONS=4
MIN_EDGE=0.00
ORDER_COOLDOWN_SECONDS=10
EDGE_FOR_POST_ONLY=0.03
EDGE_FOR_LIMIT=0.08
EDGE_FOR_MARKET=0.15

# Loss protection
DAILY_LOSS_LIMIT=0.25
MAX_CONSECUTIVE_LOSSES=3
MAX_DRAWDOWN_PCT=0.15
COOLOFF_PERIOD_MINUTES=30
PEAK_DECAY_RATE_PER_HOUR=0.05

# Risk sizing
DYNAMIC_SIZING_ENABLED=true
TARGET_VOLATILITY=0.006
KELLY_CAP=0.20
MAX_EXPOSURE_PCT=0.10
MIN_TRADE_USD=5.0

# Execution
SMART_ROUTER_ENABLED=true
MAKER_EDGE_THRESHOLD=0.02
TAKER_EDGE_THRESHOLD=0.06
MAX_SPREAD=0.05

# Monitoring
MONITORING_ENABLED=true
MONITOR_WS_PORT=8765

# ML engine (optional)
ML_ENGINE_ENABLED=false
ML_BUNDLE_PATH=models/ml_bundle
ML_FEES_BPS=2.5
ML_SLIPPAGE_BPS=2.0
ML_MIN_EV=0.01
ML_MAX_UNCERTAINTY=0.10
ML_MAX_SPREAD=0.06
ML_MIN_DEPTH=50
ML_MAX_EXPOSURE_PCT=0.10
ML_EV_SIZING_SCALE=0.10
ML_TARGET_VOLATILITY=0.006
